# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sensetrack

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Must support JSON mode. Groq changes its catalogue often — if this 404s,
# run `python -m scripts.check_setup` to see what your key can reach.
GROQ_MODEL=qwen/qwen3.8-27b

# Where the backend listens. 0.0.0.0 so the Pi can reach it over the LAN.
HOST=0.0.0.0
PORT=8000
